{{!
    @template theme_tresa/footer
    Landing page footer. Expects a "footer" object in context: sitename,
    about, col1 (title + links list), col2 (title + links list), contact
    (title, address/hasaddress, phone/phonehref/hasphone,
    email/hasemail), hascontact, copyright, backtotoptext, sociallinks
    list, hassociallinks.
}}
<footer class="tresa-footer">
    <div class="tresa-footer__inner">
        <div class="tresa-footer__about">
            <h3>{{{ footer.sitename }}}</h3>
            {{#footer.about}}
                <p>{{{ footer.about }}}</p>
            {{/footer.about}}
            {{#footer.hassociallinks}}
                <ul class="tresa-footer__social">
                    {{#footer.sociallinks}}
                        <li>
                            <a href="{{{ url }}}" target="_blank" rel="noopener" aria-label="{{ label }}">
                                <i class="fa-brands {{ icon }}" aria-hidden="true"></i>
                            </a>
                        </li>
                    {{/footer.sociallinks}}
                </ul>
            {{/footer.hassociallinks}}
        </div>

        <div class="tresa-footer__col">
            <h4>{{{ footer.col1.title }}}</h4>
            <ul>
                {{#footer.col1.links}}
                <li><a href="{{{ url }}}">{{{ text }}}</a></li>
                {{/footer.col1.links}}
            </ul>
        </div>

        <div class="tresa-footer__col">
            <h4>{{{ footer.col2.title }}}</h4>
            <ul>
                {{#footer.col2.links}}
                <li><a href="{{{ url }}}">{{{ text }}}</a></li>
                {{/footer.col2.links}}
            </ul>
        </div>

        {{#footer.hascontact}}
        <div class="tresa-footer__contact">
            <h4>{{{ footer.contact.title }}}</h4>
            <ul class="tresa-footer__contact-list">
                {{#footer.contact.hasaddress}}
                <li class="tresa-footer__contact-item">
                    <i class="fa fa-map-marker" aria-hidden="true"></i>
                    <span>{{{ footer.contact.address }}}</span>
                </li>
                {{/footer.contact.hasaddress}}
                {{#footer.contact.hasphone}}
                <li class="tresa-footer__contact-item">
                    <i class="fa fa-phone" aria-hidden="true"></i>
                    <a href="tel:{{{ footer.contact.phonehref }}}">{{{ footer.contact.phone }}}</a>
                </li>
                {{/footer.contact.hasphone}}
                {{#footer.contact.hasemail}}
                <li class="tresa-footer__contact-item">
                    <i class="fa fa-envelope" aria-hidden="true"></i>
                    <a href="mailto:{{{ footer.contact.email }}}">{{{ footer.contact.email }}}</a>
                </li>
                {{/footer.contact.hasemail}}
            </ul>
        </div>
        {{/footer.hascontact}}
    </div>

    <div class="tresa-footer__bottom">
        <span>{{{ footer.copyright }}}</span>
        <a class="tresa-footer__backtotop" href="#tresa-maincontent">{{{ footer.backtotoptext }}} &uarr;</a>
    </div>
</footer>
