{{!
    @template theme_tresa/dashboard-widgets
    Decorative study widgets for the Dashboard/My courses right-hand column
    (see lib.php: theme_tresa_get_dashboard_widgets_context). Static/demo
    content - only the focus timer actually runs (client-side only, nothing
    saved); the rest is fixed placeholder UI.

    Context: engagementdays.
}}
<div class="tresa-widget tresa-widget--focus" data-region="tresa-focus-timer">
    <div class="tresa-widget__header">
        <span class="tresa-widget__title">Focus Study Sprint</span>
    </div>
    <div class="tresa-widget__body">
        <div class="tresa-widget__timer" data-region="tresa-focus-display">25:00</div>
        <div class="tresa-widget__hint" data-region="tresa-focus-hint">Ready for sprint</div>
        <button type="button" class="btn btn-primary tresa-widget__focus-btn" data-region="tresa-focus-toggle">
            Start Focus
        </button>
    </div>
</div>

<div class="tresa-widget">
    <div class="tresa-widget__header">
        <span class="tresa-widget__title">Weekly Study Goal</span>
    </div>
    <div class="tresa-widget__body tresa-widget__goal">
        <div class="tresa-widget__goal-sliders">
            <label class="tresa-widget__slider-row">
                <span class="tresa-widget__slider-label">Weekly study</span>
                <input type="range" class="tresa-widget__slider" min="0" max="40" value="15" data-region="tresa-slider-value">
                <span class="tresa-widget__slider-value">15 hrs</span>
            </label>
            <label class="tresa-widget__slider-row">
                <span class="tresa-widget__slider-label">Mentor link</span>
                <input type="range" class="tresa-widget__slider" min="0" max="100" value="80" data-region="tresa-slider-value">
                <span class="tresa-widget__slider-value">80%</span>
            </label>
        </div>
        <div class="tresa-widget__gauge" style="--tresa-gauge-percent: 55;">
            <span class="tresa-widget__gauge-value">55%</span>
            <span class="tresa-widget__gauge-label">Index</span>
        </div>
    </div>
</div>

<div class="tresa-widget">
    <div class="tresa-widget__header">
        <span class="tresa-widget__title">Your Own Cognitive Co-Pilot</span>
    </div>
    <div class="tresa-widget__body">
        <form class="tresa-widget__copilot" data-region="tresa-copilot-form">
            <input type="text" class="tresa-widget__copilot-input" placeholder="Ask AI Study Buddy...">
            <button type="submit" class="btn btn-primary tresa-widget__copilot-send" aria-label="Send">
                <i class="fa fa-arrow-right" aria-hidden="true"></i>
            </button>
        </form>
    </div>
</div>

<div class="tresa-widget">
    <div class="tresa-widget__header">
        <span class="tresa-widget__title">Study Engagement Graph</span>
    </div>
    <div class="tresa-widget__body">
        <div class="tresa-widget__chart">
            {{#engagementdays}}
            <div class="tresa-widget__bar-col">
                <div class="tresa-widget__bar" style="height: {{percent}}%;"></div>
                <span class="tresa-widget__bar-label">{{label}}</span>
            </div>
            {{/engagementdays}}
        </div>
    </div>
</div>
