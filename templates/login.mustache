{{!
    @template theme_tresa/login
    Centred login card on a deep green page (reference design).
}}
{{> theme_tresa/head }}
<body {{{ bodyattributes }}}>
{{{ output.standard_top_of_body_html }}}
<div class="tresa-login"{{#hasbgimage}} style="background-image: linear-gradient(rgba(0, 76, 33, .78), rgba(0, 76, 33, .78)), url('{{{ bgimageurl }}}');"{{/hasbgimage}}>
    <div class="tresa-login__card">
        <a href="{{{ homeurl }}}" class="tresa-login__logo">
            <img src="{{{ tresalogourl }}}" alt="{{ sitename }}">
        </a>
        <h1 class="tresa-login__welcome">{{#str}} loginwelcome, theme_tresa {{/str}}</h1>
        <p class="tresa-login__lead">{{#str}} loginlead, theme_tresa {{/str}}</p>
        {{#loginnotices}}<div class="tresa-login__notices">{{{ loginnotices }}}</div>{{/loginnotices}}
        <main id="tresa-maincontent" tabindex="-1">
            {{{ output.main_content }}}
            {{#showcustomloginlink}}
                <p class="tresa-login__extra-link">
                    <a href="{{{ customloginlinkurl }}}">{{{ customloginlinktext }}}</a>
                </p>
            {{/showcustomloginlink}}
        </main>
    </div>
    <p class="tresa-login__copy">{{{ copyrighttext }}}</p>
</div>
{{> theme_tresa/footer-scripts }}
</body>
</html>
